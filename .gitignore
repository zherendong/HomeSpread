.venv/
__pycache__/
*.pyc

# 실기기 세션 산출물 — 기기 정보가 들어 있으므로 공유 대상이 아니다.
logs/
backups/

# 아이콘 그림 — 기기에서 받아 온 남의 저작물이다. 공개 저장소에 올리지 않는다.
cache/

# 빌드 산출물
build*/
dist*/

# 고른 언어 등 이 PC 의 설정
settings.json

# 내려받은 빌드 도구(Windows SDK BuildTools). Microsoft 것이고 용량이 크다 —
# 필요하면 누구나 NuGet 에서 같은 것을 받을 수 있으므로 저장소에 싣지 않는다.
tools/

# 스토어 그림용 시연 배치와 그 아이콘. 2026-08-31 부터는 기기 자료가 아니라 전부
# 지어낸 것이지만, 스크립트 두 개로 언제든 똑같이 다시 만들어지는 산출물이라
# 저장소에 두지 않는다. (make_demo_layout.py / make_demo_icons.py)
_workspace/demo-layout.json
_workspace/demo-cache/
