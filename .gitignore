.venv/
__pycache__/
*.pyc

# 真机诊断产物含设备信息，不作为公开源码提交。
logs/
backups/

# 图标来自用户设备，不上传公开仓库。
cache/

# 构建产物
build*/
dist*/

# 本机语言等设置
settings.json

# 下载的 Windows SDK BuildTools 可按需从 NuGet 获取，不纳入源码。
tools/

# 商店截图使用的虚构布局和图标可由 make_demo_layout.py / make_demo_icons.py
# 重新生成。自 2026-08-31 起它们不再使用真实设备数据。
_workspace/demo-layout.json
_workspace/demo-cache/

# 设备信任凭据属于私有运行数据。
pairing/

# 离线草稿包含个人主屏幕原始数据，不能提交或公开分发。
drafts/
*.hsdraft

# 证据包和预检报告含设备及应用信息，只保留本地。
evidence/
preflight_reports/
*.hsevidence
*.hspreflight
