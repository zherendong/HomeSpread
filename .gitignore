.venv/
__pycache__/
*.pyc

# 실기기 세션 산출물 — 기기 정보가 들어 있으므로 공유 대상이 아니다.
logs/
backups/

# 아이콘 그림 — 기기에서 받아 온 남의 저작물이다. 공개 저장소에 올리지 않는다.
cache/

# 빌드 산출물
build*/
dist*/

# 고른 언어 등 이 PC 의 설정
settings.json

# 내려받은 빌드 도구(Windows SDK BuildTools). Microsoft 것이고 용량이 크다 —
# 필요하면 누구나 NuGet 에서 같은 것을 받을 수 있으므로 저장소에 싣지 않는다.
tools/

# 스토어 그림용 시연 배치. 항목 raw 를 기기 백업에서 그대로 꺼내 오므로
# (설치 날짜 등) 기기 자료다. scripts/make_demo_layout.py 로 언제든 다시 만든다.
_workspace/demo-layout.json
